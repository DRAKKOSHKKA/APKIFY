# Пример конфигурации локального окружения
# Скопируйте этот файл как .env.local:
# cp .env.example .env.local

# IP-адрес вашего ПК в локальной Wi-Fi/Ethernet сети.
# Необходим, если на компьютере установлены VMware, VirtualBox, Docker или WSL,
# из-за которых Expo выбирает виртуальный IP (например 192.168.254.1), недоступный с телефона.
# Узнать свой реальный IP в Windows: выполните в PowerShell/CMD команду "ipconfig" (строка IPv4-адрес).
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100
